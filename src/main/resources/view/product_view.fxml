<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.presentation.ProductController"
            prefWidth="800" prefHeight="600">
    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
        <Label text="Product Management" styleClass="title-label"/>
        <HBox spacing="10">
            <TextField fx:id="nameField" promptText="Product Name"/>
            <TextField fx:id="stockField" promptText="Stock"/>
            <TextField fx:id="priceField" promptText="Price"/>
            <Button text="Add" fx:id="addProductButton"/>
            <Button fx:id="updateProductButton" text="Update" />

        </HBox>
        <ScrollPane fitToWidth="true" prefHeight="500">
            <FlowPane fx:id="productFlowPane" hgap="25" vgap="25" style="-fx-padding: 15px"/>
        </ScrollPane>
    </VBox>
</AnchorPane>
