<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.presentation.OrderController"
            prefWidth="800" prefHeight="600">

    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">

        <!-- Order Form -->
        <Label text="Create Order" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <HBox spacing="10">
            <ComboBox fx:id="clientComboBox" promptText="Select Client" prefWidth="150"/>
            <ComboBox fx:id="productComboBox" promptText="Select Product" prefWidth="150"/>
            <TextField fx:id="quantityField" promptText="Quantity" prefWidth="100"/>
            <Button text="Place Order" fx:id="placeOrderButton" onAction="#handlePlaceOrder"/>
        </HBox>
        <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;" />

        <!-- Orders Table -->
        <TableView fx:id="orderTable" prefHeight="400">
            <columns>
                <TableColumn fx:id="clientIdCol" text="Client ID" prefWidth="80"/>
                <TableColumn fx:id="clientNameCol" text="Client Name" prefWidth="120"/>
                <TableColumn fx:id="productIdCol" text="Product ID" prefWidth="80"/>
                <TableColumn fx:id="productNameCol" text="Product Name" prefWidth="150"/>
                <TableColumn fx:id="quantityCol" text="Quantity" prefWidth="80"/>
                <TableColumn fx:id="priceCol" text="Price" prefWidth="100"/>
            </columns>
        </TableView>

        <!-- Delete Button -->
        <HBox alignment="CENTER_RIGHT">
            <Button text="Delete Selected Order" onAction="#handleDeleteOrder"/>
        </HBox>
    </VBox>
</AnchorPane>
