<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.presentation.ClientController"
            prefWidth="600" prefHeight="400">
    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
        <Label text="Client Management"/>
        <HBox spacing="10">
            <TextField fx:id="nameField" promptText="Client Name"/>
            <TextField fx:id="emailField" promptText="Email"/>
            <Button text="Add" fx:id="addClientButton"/>
        </HBox>
        <TableView fx:id="clientTable" prefHeight="300" />
    </VBox>
</AnchorPane>

